{
  "name": "arkade-p2pd",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Arkade P2P daemon (Nostr + Arkade SDK)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/db/messages.test.ts src/db/relays.test.ts src/db/outbox.test.ts src/nostr/relayPool.test.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.4.79",
    "@noble/secp256k1": "^2.1.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "nanoid": "^5.0.9",
    "nostr-tools": "^2.25.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
